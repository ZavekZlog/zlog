      ],
      "allowedGlobs": [
        "lib/diary-*.js",
        "lib/project-*.js",
        "lib/golden-journeys/**",
        "lib/photo-workspace/**"
      ],
      "maxProductFiles": 25,
      "allowsHighRisk": false,
      "requiresUserApproval": false
    },
    "dashboard-shell": {
