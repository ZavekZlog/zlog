{
  "version": "1.0.0",
  "updated": "2026-08-14",
  "description": "Machine-readable protected-scope architecture. Future agents must declare ZLOG_TASK_SCOPE (or .zlog-task-scope.json) before release. Unrelated protected/high-risk edits HARD FAIL.",
  "canonicalReleaseCommand": "npm run test:release",
  "legacyReleaseCommand": "npm run test:release-gate",
  "honesty": {
    "visualRegression": "Installed for status=approved screens only (landing, login). Playwright screenshot baselines under e2e/visual/__baselines__. Dashboard/Sign out/diary shells are known_regression or pending_manual_confirmation — NOT baselined. See docs/VISUAL_REGRESSION.md.",
    "sourceContracts": "String/structure assertions in *.contract.test.js prove wiring, not on-screen geometry.",
    "playwrightE2E": "Behavioural UI E2E (auth wall / form semantics) — separate from screenshot visual regression."
  },
  "features": {
    "LANDING_AUTH": {
      "label": "Landing / Auth",
      "paths": [
        "app/page.tsx",
        "app/(auth)/",
        "lib/auth/",
        "lib/supabase/",
        "proxy.js",
        "proxy.ts",
        "middleware.js",
        "middleware.ts"
      ]
    },
    "DASHBOARD": {
      "label": "Dashboard",
      "paths": [
        "app/dashboard/page.jsx",
        "components/dashboard/DashboardTopBar.jsx"
      ]
    },
    "GLOBAL_APP_SHELL": {
      "label": "Global app shell",
      "paths": [
        "app/layout.tsx",
        "app/globals.css",
        "lib/premium-ui.jsx",
        "lib/premium-ui.js"
      ],
      "blastRadius": "high"
    },
    "ZLOG_HEADER_WORDMARK": {
      "label": "Zlog header / wordmark",
      "paths": [
        "lib/premium-ui.jsx",
        "components/dashboard/DashboardTopBar.jsx"
      ],
      "notes": "ZlogTextWordmarkLetters / ZlogWordmark / ZlogBrandWordmark live in premium-ui."
    },
    "SIGN_OUT_CONTROL": {
      "label": "Sign out control",
      "paths": [
        "components/dashboard/DashboardTopBar.jsx",
        "lib/auth/",
        "app/globals.css"
      ],
      "notes": "Sign out restored from 9b941f3 (framed utility below full ZlogBrandRegion). Right-aligned via DASHBOARD_CONTENT_GRID. Glow/pageBackground from locked premium-ui tokens — do not invent replacements."
    },
    "BACK_NAVIGATION": {
      "label": "Back navigation",
      "paths": [
        "lib/premium-ui.jsx",
        "app/globals.css"
      ],
      "notes": "ZlogBackControl + .zlog-secondary-cta / .zlog-back-cta"
    },
    "GLOBAL_CTA_SYSTEM": {
      "label": "Global CTA system",
      "paths": [
        "lib/premium-ui.jsx",
        "app/globals.css",
        "DESIGN.md"
      ],
      "notes": "PrimaryCTA, SecondaryButton, .zlog-secondary-cta — LOCKED enamel treatment."
    },
    "SITE_DIARY_WORKBENCH_SHELL": {
      "label": "Site Diary workbench shell",
      "paths": [
        "app/dashboard/diary/",
        "app/dashboard/project/[id]/diary/",
        "docs/contracts/SITE_DIARY_SCREEN_CONTRACT.md",
        "docs/PROTECTED_SITE_DIARY_CONTRACT.md"
      ]
    },
    "APPROVED_TYPOGRAPHY": {
      "label": "Approved typography",
      "paths": [
        "app/globals.css",
        "DESIGN.md",
        "lib/premium-ui.jsx"
      ],
      "blastRadius": "high"
    },
    "GLOBAL_COLOUR_TOKENS": {
      "label": "Global colour tokens",
      "paths": [
        "app/globals.css",
        "DESIGN.md",
        "lib/report-theme.js",
        "lib/report-theme.ts"
      ],
      "blastRadius": "high"
    },
    "DATABASE_SCHEMA": {
      "label": "Database / schema contracts",
      "paths": [
        "supabase/migrations/"
      ],
      "blastRadius": "high"
    },
    "REPORT_PDF_BRANDING": {
      "label": "Report / PDF branding pipeline",
      "paths": [],
      "globs": [
        "**/report*brand*",
        "**/pdf/**",
        "lib/report-theme.*"
      ],
      "blastRadius": "high"
    }
  },
  "alwaysProtectedPaths": [
    "app/(auth)/",
    "app/page.tsx",
    "app/layout.tsx",
    "app/globals.css",
    "app/dashboard/page.jsx",
    "lib/auth/",
    "lib/supabase/",
    "components/dashboard/DashboardTopBar.jsx",
    "lib/premium-ui.jsx",
    "lib/premium-ui.js",
    "proxy.js",
    "proxy.ts",
    "middleware.js",
    "middleware.ts",
    "supabase/migrations/",
    "docs/ZLOG_PRODUCT_CONSTITUTION.md",
    "DESIGN.md"
  ],
  "alwaysProtectedGlobs": [
    "**/report*brand*",
    "**/pdf/**",
    "lib/report-theme.*"
  ],
  "highRiskShared": [
    {
      "path": "app/layout.tsx",
      "reason": "Root layout — every screen"
    },
    {
      "path": "app/globals.css",
      "reason": "Global tokens + Back plate (.zlog-secondary-cta) and isolated Sign out (.zlog-dashboard-signout)"
    },
    {
      "path": "lib/premium-ui.jsx",
      "reason": "PrimaryCTA, Back, wordmark, PremiumShell — multi-screen blast radius"
    },
    {
      "path": "lib/premium-ui.js",
      "reason": "Legacy alias of premium-ui"
    },
    {
      "path": "components/dashboard/DashboardTopBar.jsx",
      "reason": "Dashboard masthead + Sign out"
    },
    {
      "path": "proxy.js",
      "reason": "Auth wall / session refresh (Next 16 root proxy)"
    },
    {
      "path": "middleware.js",
      "reason": "Auth wall / routing"
    },
    {
      "path": "middleware.ts",
      "reason": "Auth wall / routing"
    },
    {
      "path": "supabase/migrations/",
      "reason": "Schema contracts"
    }
  ],
  "scopes": {
    "anti-regression-tooling": {
      "description": "Guardrail infrastructure only (manifests, gate scripts, cursor rules, registry).",
      "allowedPathPrefixes": [
        "docs/PROTECTED_SCOPE_MANIFEST.json",
        "docs/PROTECTED_CODE_BOUNDARIES.json",
        "docs/PROTECTED_CODE_BOUNDARIES.md",
        "docs/ANTI_REGRESSION_ENFORCEMENT.md",
        "docs/VISUAL_REGRESSION.md",
        "docs/ZLOG_RELEASE_GATE.md",
        "docs/contracts/APPROVED_UI_COPY.json",
        "docs/contracts/APPROVED_BEHAVIOUR_REGISTRY.json",
        "scripts/",
        "e2e/visual/",
        "playwright.config.js",
        "playwright.visual.config.mjs",
        ".cursor/rules/",
        "package.json",
        ".gitignore"
      ],
      "allowedGlobs": [
        "scripts/**",
        "e2e/visual/**",
        ".cursor/rules/**",
        "lib/**/*contract*.test.js",
        "lib/**/*resilience*.test.js"
      ],
      "maxProductFiles": 8,
      "allowsHighRisk": false,
      "requiresUserApproval": false
