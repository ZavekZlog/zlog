      "allowsHighRisk": true,
      "requiresUserApproval": true
    },
    "saved-report-deletion": {
      "description": "Approved saved-report management: compact list/selection UX plus RPC/outbox, confirmation dialog, Site Diary list/viewer and project-page delete path.",
      "allowedPathPrefixes": [
